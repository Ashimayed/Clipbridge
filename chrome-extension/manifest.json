{
  "manifest_version": 3,
  "name": "ClipBridge",
  "version": "2.0.0",
  "description": "Shares your clipboard between Chrome and your Android phone, end-to-end encrypted, through your own Google Drive.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "identity",
    "offscreen",
    "clipboardRead",
    "clipboardWrite",
    "notifications",
    "storage",
    "alarms",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "678940821782-fup6ogiqf9dnqa4hhmbaqailng6ehlgb.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ClipBridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
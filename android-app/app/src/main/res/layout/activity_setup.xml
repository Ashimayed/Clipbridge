<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ground" android:fillViewport="true">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:id="@+id/column" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_gravity="center_horizontal" android:orientation="vertical"
        android:paddingStart="24dp" android:paddingTop="24dp" android:paddingEnd="24dp" android:paddingBottom="28dp">

        <!-- ===== Step 1: welcome ===== -->
        <LinearLayout android:id="@+id/stepWelcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/T.Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textFontWeight="700" android:textSize="18sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="56dp"
                android:gravity="center" android:importantForAccessibility="noHideDescendants" android:orientation="horizontal">
                <ImageView android:layout_width="96dp" android:layout_height="132dp" android:background="@drawable/bg_hero_device"
                    android:scaleType="fitCenter" android:padding="22dp" android:src="@drawable/ic_phone" android:tint="@color/cobalt" android:contentDescription="@null" />
                <View android:layout_width="22dp" android:layout_height="2dp" android:layout_marginStart="14dp" android:background="@drawable/bg_line" />
                <View android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_link_node" />
                <View android:layout_width="22dp" android:layout_height="2dp" android:layout_marginEnd="14dp" android:background="@drawable/bg_line" />
                <ImageView android:layout_width="132dp" android:layout_height="132dp" android:background="@drawable/bg_hero_device"
                    android:scaleType="fitCenter" android:padding="30dp" android:src="@drawable/ic_laptop" android:tint="@color/cobalt" android:contentDescription="@null" />
            </LinearLayout>
            <TextView style="@style/T.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40dp"
                android:lineSpacingMultiplier="0.95" android:text="Copy here.\nPaste there." android:textSize="40sp" />
            <TextView style="@style/T.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="Your phone and Chrome share one clipboard through your own Google Drive. Everything is encrypted before it leaves the device." android:textSize="17sp" />
            <Button android:id="@+id/btnSignIn" style="@style/Btn.Dark" android:layout_width="match_parent" android:layout_marginTop="40dp"
                android:drawableStart="@drawable/ic_user" android:text="Sign in with Google" />
            <TextView android:id="@+id/welcomeNote" style="@style/T.Meta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center" android:text="Use the same account as Chrome on your PC." android:textSize="14sp" />
        </LinearLayout>

        <!-- ===== Step 2: passphrase ===== -->
        <LinearLayout android:id="@+id/stepPass" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="-14dp" android:gravity="center_vertical">
                <ImageButton android:id="@+id/btnBack" style="@style/IconBtn" android:contentDescription="Back" android:src="@drawable/ic_back" />
                <TextView android:id="@+id/stepLabel" style="@style/T.Meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Step 2 of 2" android:textSize="14sp" />
            </LinearLayout>
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:layout_marginTop="18dp" android:background="@drawable/bg_tile_big"
                android:contentDescription="@null" android:scaleType="center" android:src="@drawable/ic_lock" android:tint="@color/cobalt" />
            <TextView style="@style/T.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="Set your passphrase" android:textSize="30sp" />
            <TextView style="@style/T.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="Use the same one on your phone and in Chrome. It locks every clip, and it never leaves your devices." />
            <TextView style="@style/T.Row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp"
                android:labelFor="@+id/pass1" android:text="Passphrase" android:textFontWeight="600" android:textSize="14sp" />
            <EditText android:id="@+id/pass1" style="@style/Input" android:layout_width="match_parent" android:layout_marginTop="6dp" />
            <TextView style="@style/T.Row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:labelFor="@+id/pass2" android:text="Type it again" android:textFontWeight="600" android:textSize="14sp" />
            <EditText android:id="@+id/pass2" style="@style/Input" android:layout_width="match_parent" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/passHint" style="@style/T.Meta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="At least 10 characters. A few random words work well." />

            <LinearLayout android:id="@+id/warnCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:background="@drawable/bg_warn" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
                <TextView style="@style/T.Row" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/danger"
                    android:text="This doesn't match your other device" android:textFontWeight="600" />
                <TextView style="@style/T.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="Clips already in Drive were locked with a different passphrase, so this phone couldn't open them. Check for a typo, or use this one on both devices." android:textSize="14sp" />
                <Button android:id="@+id/btnUseAnyway" style="@style/Btn.Quiet" android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="12dp" android:text="Use this passphrase anyway" android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/keyCheckCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:background="@drawable/bg_group" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp" android:visibility="gone">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/T.Row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Key check" android:textFontWeight="600" android:textSize="15sp" />
                    <TextView style="@style/T.Meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                        android:text="Chrome should show the same code." />
                </LinearLayout>
                <TextView android:id="@+id/keyCheckCode" style="@style/T.Code" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" />
            </LinearLayout>

            <TextView android:id="@+id/passStatus" style="@style/T.Meta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" android:gravity="center" android:textSize="14sp" />
            <Button android:id="@+id/btnSavePass" style="@style/Btn.Primary" android:layout_width="match_parent" android:layout_marginTop="12dp"
                android:text="Save passphrase" />
            <Button android:id="@+id/btnScanQr" style="@style/Btn.Quiet" android:layout_width="match_parent" android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_qr" android:text="Or scan the QR code from Chrome" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ground">
    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingBottom="104dp">
        <LinearLayout android:id="@+id/column" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
                android:paddingStart="4dp" android:paddingTop="18dp" android:paddingBottom="10dp">
                <TextView style="@style/T.Title" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/app_name" />
                <ImageButton android:id="@+id/btnSettings" style="@style/IconBtn" android:contentDescription="Settings" android:src="@drawable/ic_gear" />
            </LinearLayout>
            <include layout="@layout/bridge_card" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_small" android:gravity="center_vertical" android:minHeight="44dp"
                android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="8dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null"
                    android:src="@drawable/ic_search" android:tint="@color/ink2" />
                <EditText android:id="@+id/searchBox" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_weight="1" android:background="@null"
                    android:hint="Search your clips" android:imeOptions="actionSearch" android:inputType="text"
                    android:maxLines="1" android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:textColor="@color/ink" android:textColorHint="@color/ink2" android:textSize="15sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom"
                android:paddingStart="4dp" android:paddingTop="24dp" android:paddingEnd="4dp" android:paddingBottom="10dp">
                <TextView style="@style/T.Section" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Recent" />
                <TextView style="@style/T.Meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Last 10 kept" />
            </LinearLayout>
            <TextView android:id="@+id/emptyText" style="@style/T.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_group" android:padding="18dp" android:visibility="gone"
                android:text="Nothing yet. Copy something on your PC, or tap Send clipboard." />
            <LinearLayout android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:background="@color/ground" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="22dp">
        <Button android:id="@+id/btnSend" style="@style/Btn.Primary" android:layout_width="match_parent"
            android:layout_gravity="center_horizontal" android:drawableStart="@drawable/ic_send" android:text="Send clipboard" />
    </FrameLayout>
</FrameLayout>

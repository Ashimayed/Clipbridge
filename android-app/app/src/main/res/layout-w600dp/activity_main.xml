<?xml version="1.0" encoding="utf-8"?>
<!-- Tablets, foldables, landscape: controls on the left, clips on the right. MainActivity pads it for system bars. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
        android:paddingStart="28dp" android:paddingEnd="28dp">
        <ScrollView android:id="@+id/leftPane" android:layout_width="360dp" android:layout_height="match_parent" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingTop="22dp" android:paddingBottom="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingBottom="14dp">
                    <TextView style="@style/T.Title" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:accessibilityHeading="true" android:text="@string/app_name" android:textSize="26sp" />
                    <ImageButton android:id="@+id/btnSettings" style="@style/IconBtn" android:contentDescription="Settings" android:src="@drawable/ic_gear" />
                </LinearLayout>
                <include layout="@layout/bridge_card" />
                <Button android:id="@+id/btnSend" style="@style/Btn.Primary" android:layout_width="match_parent" android:layout_marginTop="18dp"
                    android:drawableStart="@drawable/ic_clipboard" android:text="Send clipboard" />
                <TextView style="@style/T.Group" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="22dp" android:layout_marginBottom="8dp" android:paddingStart="4dp" android:text="Send text or files" />
                <include layout="@layout/composer" />
                <TextView style="@style/T.Group" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="22dp" android:layout_marginBottom="8dp" android:paddingStart="4dp" android:text="This device" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_group" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
                        android:minHeight="56dp" android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView style="@style/T.Row" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Key check" />
                        <TextView android:id="@+id/keyCheckValue" style="@style/T.Code" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="@color/line" />
                    <Switch android:id="@+id/receiveSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Receive from your other devices" android:textColor="@color/ink"
                        android:textFontWeight="500" android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <androidx.core.widget.NestedScrollView android:id="@+id/scroll" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_marginStart="28dp" android:layout_weight="1" android:clipToPadding="false">
            <LinearLayout android:id="@+id/column" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingTop="34dp" android:paddingBottom="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_small" android:gravity="center_vertical" android:minHeight="44dp"
                    android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="8dp">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null"
                        android:src="@drawable/ic_search" android:tint="@color/ink2" />
                    <EditText android:id="@+id/searchBox" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:layout_weight="1" android:background="@null"
                        android:hint="Search your clips" android:imeOptions="actionSearch" android:importantForAutofill="no" android:inputType="text"
                        android:maxLines="1" android:paddingTop="10dp" android:paddingBottom="10dp"
                        android:textColor="@color/ink" android:textColorHint="@color/ink2" android:textSize="15sp" />
                </LinearLayout>
                <TextView android:id="@+id/emptyText" style="@style/T.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:background="@drawable/bg_group" android:padding="18dp" android:visibility="gone" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/clipList" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:overScrollMode="never" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <include layout="@layout/undo_bar" />
</FrameLayout>

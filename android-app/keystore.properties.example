# Copy this file to "keystore.properties" in this same folder (android-app/) and fill in
# your own values. keystore.properties is gitignored — never commit the real file.
#
# storeFile is a path relative to android-app/ (put the .keystore file itself somewhere
# in android-app/, e.g. android-app/app/ — it's covered by .gitignore too).
#
# This is only needed for building locally. CI (GitHub Actions) instead reads
# CLIPBRIDGE_KEYSTORE_FILE / CLIPBRIDGE_KEYSTORE_PASSWORD / CLIPBRIDGE_KEY_ALIAS from
# repository secrets — see README.md.

storeFile=app/clipbridge-v2.keystore
storePassword=changeme
keyAlias=clipbridge
keyPassword=changeme
